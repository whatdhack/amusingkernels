# Copy to .env. Never commit the populated file.
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_API_MODEL=muse-spark-1.3-contributor
# The SOL-ExecBench problem to optimize: a folder with definition.json + workload.jsonl
# (absolute, or relative to this directory).
PROBLEM_DIR=../SOL-ExecBench/data/benchmark/L1/085_geglu_activation
# Author tag stamped into built solutions.
AUTHOR=amusingkernels
# Evaluator binary (default: sol-execbench on PATH).
SOL_EXECBENCH=sol-execbench
# Eval backend: local GPU, or Modal (MODAL_GPU, default B200; bills that workspace).
EVAL_BACKEND=local
MODAL_GPU=B200
# The agent's own Python: the rsi conda interpreter on this machine.
PYTHON=/home/sgoswami/miniforge3/envs/rsi/bin/python
